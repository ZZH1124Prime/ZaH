{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16", "strict": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": ".", "types": ["node"], "lib": ["ES2022", "DOM"], "noUncheckedIndexedAccess": true
  },
  "include": ["main/**/*.ts", "preload/**/*.ts", "protocol/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
