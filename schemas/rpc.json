{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zah.local/schemas/rpc-v1.json",
  "title": "ZaH local RPC v1 wire envelopes",
  "x-zah": {
    "protocol_version": 1,
    "max_frame_bytes": 1048576,
    "max_connections": 32,
    "request_timeout_seconds": 30
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "type": "string",
          "x-go-name": "JSONRPC"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "x-go-name": "ID",
          "x-go-type": "json.RawMessage",
          "x-ts-type": "string | number | null"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "params": {
          "type": [
            "object",
            "array"
          ],
          "x-go-type": "json.RawMessage",
          "x-ts-type": "Record<string, unknown> | unknown[]"
        }
      }
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "type": "string",
          "x-go-name": "JSONRPC"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "x-go-name": "ID",
          "x-go-type": "json.RawMessage",
          "x-ts-type": "string | number | null"
        },
        "result": {
          "x-go-type": "json.RawMessage",
          "x-ts-type": "unknown"
        },
        "error": {
          "$ref": "#/$defs/Error",
          "x-go-type": "*Error",
          "x-ts-type": "RPCError"
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "x-go-type": "any",
          "x-ts-type": "unknown"
        }
      }
    },
    "HelloParams": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        }
      }
    },
    "HelloResult": {
      "type": "object",
      "required": [
        "version",
        "max_frame_bytes",
        "max_connections"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "max_frame_bytes": {
          "type": "integer",
          "const": 1048576,
          "x-go-name": "MaxFrameBytes"
        },
        "max_connections": {
          "type": "integer",
          "const": 32,
          "x-go-name": "MaxConnections"
        }
      }
    },
    "CatalogRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "data",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-go-name": "ID"
        },
        "kind": {
          "type": "string"
        },
        "data": {
          "x-go-type": "json.RawMessage",
          "x-ts-type": "unknown"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "x-go-name": "CreatedAt"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "x-go-name": "UpdatedAt"
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "type",
        "data",
        "created_at"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-go-type": "int64",
          "x-ts-type": "number"
        },
        "type": {
          "type": "string"
        },
        "data": {
          "x-go-type": "json.RawMessage",
          "x-ts-type": "unknown"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "x-go-name": "CreatedAt"
        }
      }
    },
    "ResumeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "after": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-go-type": "*int64",
          "x-ts-type": "number | null"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      }
    },
    "EventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "next_cursor",
        "has_more"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "maxItems": 500,
          "x-go-type": "[]Event",
          "x-ts-type": "Event[]"
        },
        "next_cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-go-name": "NextCursor",
          "x-go-type": "int64",
          "x-ts-type": "number"
        },
        "has_more": {
          "type": "boolean",
          "x-go-name": "HasMore",
          "x-go-type": "bool",
          "x-ts-type": "boolean"
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/CatalogRecord"
            }
          },
          "x-go-type": "map[string][]CatalogRecord",
          "x-ts-type": "Record<string, CatalogRecord[]>"
        }
      }
    },
    "ApplicationsStopAllInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed"
      ],
      "properties": {
        "confirmed": {
          "type": "boolean",
          "const": true,
          "x-go-type": "bool",
          "x-ts-type": "true"
        }
      }
    },
    "ApplicationsStopAllPlanParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "input"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "const": "applications.stopAll"
        },
        "input": {
          "$ref": "#/$defs/ApplicationsStopAllInput",
          "x-go-type": "ApplicationsStopAllInput",
          "x-ts-type": "ApplicationsStopAllInput"
        }
      }
    },
    "InstanceStopInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "InstanceStopPlanParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "input"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "const": "instance.stop"
        },
        "input": {
          "$ref": "#/$defs/InstanceStopInput",
          "x-go-type": "InstanceStopInput",
          "x-ts-type": "InstanceStopInput"
        }
      }
    },
    "ReleaseIconSetParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    }
  }
}
