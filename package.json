{
  "name": "zah",
  "version": "0.1.0",
  "private": true,
  "description": "ZaH Linux application management workbench",
  "main": "desktop/dist/main/index.js",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build:go": "node scripts/build-go.cjs",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "build:frontend": "tsc -p frontend/tsconfig.json --noEmit && vite build --config frontend/vite.config.ts",
    "build": "npm run build:go && npm run build:desktop && npm run build:frontend",
    "dev": "python3 scripts/dev.py --build",
    "start": "python3 scripts/dev.py",
    "check:runtime": "python3 scripts/dev.py --check",
    "test:desktop": "npm run build:desktop && node --test desktop/dist/tests/*.test.js",
    "test:frontend": "vitest run --config frontend/vite.config.ts",
    "test": "npm run test:desktop && npm run test:frontend",
    "setup:electron": "install-electron",
    "test:manager": "npm run build:desktop && node desktop/dist/tests/manager.integration.js",
    "test:electron": "node scripts/verify-desktop.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
